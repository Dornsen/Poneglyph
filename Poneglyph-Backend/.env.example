# Copy this file to `.env` and fill in the values marked REQUIRED.
# Everything else has a default and can be left as it is.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port of the API (default 5000)
PORT=5000
# development | production | test (tests set it themselves). In "test" rate limiting is off
NODE_ENV=development
# Allowed browser origins, comma separated. Leave empty to allow all (development only)
CORS_ORIGINS=http://localhost:5173
# Used to build the links in verification and password reset emails
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# REQUIRED. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Create the empty database first: CREATE DATABASE usof_db;
DATABASE_URL="postgresql://postgres:password@localhost:5432/usof_db?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED. Any long random string
# The server refuses to start without it
JWT_SECRET=change_me_to_a_long_random_string
# How long a login token is valid (default 1d)
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# SMTP (verification and password reset emails)
# ---------------------------------------------------------------------------
# Needed for registering new accounts and resetting passwords.
# Gmail: enable 2-step verification and create an "app password", use it as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Poneglyph Team" <your_email@gmail.com>

# ---------------------------------------------------------------------------
# Seed (npm run seed / npm run db:reset)
# ---------------------------------------------------------------------------
# Login and email of the first administrator
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_EMAIL=admin@example.com
# Password of every demo account (default Password123!)
SEED_PASSWORD=Password123!

# ---------------------------------------------------------------------------
# Tests (npm test)
# ---------------------------------------------------------------------------
# Tests do NOT read this file. Create a separate `.env.test` (it is git-ignored) with:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/usof_test?schema=public"
#   JWT_SECRET=any_string_for_tests
#   NODE_ENV=test
# The database name must contain "test", otherwise the runner refuses to start.
